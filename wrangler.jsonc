{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riversidesalesdashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "0 12 * * SUN"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "ARENA_STATS",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
